@model DoAnLapTrinhWeb.Models.Post
@using DoAnLapTrinhWeb.Models
@{
    ViewData["Title"] = "Bảng tin";
    var posts = ViewBag.Posts as List<Post>;
}

<div class="container-fluid mt-4">
    <nav class="nav-short delay">
        <div class="nav-short__item nav-short__item-news nav-short__item--active">
            <span class="nav-short__item-link">
                <i class="nav-short__icon fas fa-tv"></i>
                </a>
        </div>
        <div class="nav-short__item nav-short__item-member">
            <span class="nav-short__item-link">
                <i class="nav-short__icon fas fa-user"></i>
                </a>
        </div>
        <div class="nav-short__item nav-short__item-groups">
            <span class="nav-short__item-link">
                <i class="nav-short__icon fas fa-users"></i>
            </span>
        </div>
        <div class="nav-short__item nav-short__item-blog">
            <span class="nav-short__item-link">
                <i class="nav-short__icon fas fa-blog"></i>
            </span>
        </div>
        <div class="nav-short__item nav-short__item-badges">
            <span class="nav-short__item-link">
                <i class="nav-short__icon fas fa-ribbon"></i>
            </span>
        </div>
        <div class="nav-short__item nav-short__item-quests">
            <span class="nav-short__item-link">
                <i class="nav-short__icon fas fa-star-half-alt"></i>
            </span>
        </div>
        <div class="nav-short__item nav-short__item-ranks">
            <span class="nav-short__item-link">
                <i class="nav-short__icon fas fa-layer-group"></i>
            </span>
        </div>
        <div class="nav-short__item nav-short__item-credits">
            <span class="nav-short__item-link">
                <i class="nav-short__icon far fa-gem"></i>
            </span>
        </div>

    </nav>
    
    <div class="banner" style="background-image: url(./images/banner-bg.png);">
        <img src="./images/newsfeed-icon.png" alt="" class="banner-icon">
        <div class="banner-info">
            <p class="banner-info__newsfeed">Newfeed</p>
            <p class="banner-info__check">Check what your friends have been up to!</p>
        </div>
    </div>
    <div class="row">

        <!-- Sidebar trái -->
        <div class="col-md-3 bg-light p-3">
            <h5 class="mb-4">📋 Menu</h5>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link" href="#"><i class="fas fa-tv"></i> Bảng tin</a></li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("MyFriends", "Profile")">
                        <i class="fas fa-user-friends"></i> Bạn bè
                    </a>
                </li>
                <li class="nav-item"><a class="nav-link" href="#"><i class="fas fa-users"></i> Nhóm</a></li>
                <li class="nav-item"><a class="nav-link" href="#"><i class="fas fa-store"></i> Marketplace</a></li>
                <li class="nav-item"><a class="nav-link" href="#"><i class="fas fa-video"></i> Video</a></li>
            </ul>
        </div>

        <!-- Bảng tin trung tâm -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="mb-3">📝 Đăng bài viết mới</h5>

                    <form asp-action="Index" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <textarea asp-for="Content" class="form-control" rows="3" placeholder="Bạn đang nghĩ gì?"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <input type="file" name="imageFile" class="form-control" />
                        </div>

                        

                        <button type="submit" class="btn btn-primary w-100">Đăng</button>
                    </form>
                </div>
            </div>

            <!-- Danh sách bài viết -->
            @if (posts != null && posts.Any())
            {
                foreach (var post in posts)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <strong>@post.User?.UserName</strong>
                                <small class="text-muted">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>

                            @if (!string.IsNullOrEmpty(post.ImagePath))
                            {
                                <img src="@post.ImagePath" class="img-fluid my-2 rounded" />
                            }

                            <p>@post.Content</p>
                            <!-- Hiển thị bình luận -->
                            <div class="mt-3 ps-3">
                                <h6>__________________________________________________________________________________</h6>
                                <h6 class="text-muted">💬 Bình luận</h6>
                                @if (post.Comments != null && post.Comments.Any())
                                {
                                    foreach (var comment in post.Comments)
                                    {
                                        <div class="mb-2">
                                            <strong>@comment.User?.UserName</strong>: @comment.Content
                                            <div class="text-muted small">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">Chưa có bình luận nào.</p>
                                }

                                <!-- Form gửi bình luận -->
                                <form asp-controller="Post" asp-action="AddComment" method="post" class="mt-2">
                                    <input type="hidden" name="PostId" value="@post.Id" />
                                    <div class="input-group">
                                        <input type="text" name="Content" class="form-control" placeholder="Viết bình luận..." required />
                                        <button type="submit" class="btn btn-outline-primary">Gửi</button>
                                    </div>
                                </form>
                            </div>
                            @if (!string.IsNullOrEmpty(post.LikeType))
                            {
                                <div class="text-muted">
                                    Cảm xúc:
                                    @{
                                        var emoji = post.LikeType switch
                                        {
                                            "like" => "👍",
                                            "love" => "❤️",
                                            "haha" => "😂",
                                            "sad" => "😢",
                                            "angry" => "😡",
                                            _ => ""
                                        };
                                    }
                                    <span>@emoji</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Chưa có bài viết nào.</p>
            }
        </div>

        <!-- Cột phải -->
        <div class="col-md-3">
            <div class="bg-white p-3 shadow-sm rounded mb-4">
                <h6 class="text-primary">🎯 Gợi ý kết bạn</h6>
                @if (ViewBag.SuggestedUsers != null)
                {
                    foreach (var user in ViewBag.SuggestedUsers as List<ApplicationUser>)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <img src="@user.Image ?? " /images/default-avatar.png"" width="40" class="rounded-circle me-2" />
                            <div>
                                <a href="@Url.Action("ProfileDetail", "Profile", new { id = user.Id })" class="text-decoration-none fw-bold text-dark">
                                    @user.FullName
                                </a>
                                <form asp-action="Follow" method="post" class="mt-1">
                                    <input type="hidden" name="id" value="@user.Id" />
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Không có ai để gợi ý.</p>
                }
            </div>
            <div id="friends-container" class="friends-container"></div>
        </div>


    </div>
    
