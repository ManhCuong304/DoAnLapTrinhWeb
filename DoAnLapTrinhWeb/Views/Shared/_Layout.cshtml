<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mạng xã hội</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebBanStore.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/base/grid.css">
    <link rel="stylesheet" href="~/base/base.css">
    <link rel="stylesheet" href="~/base/blog.css">
    <link rel="stylesheet" href="~/base/main.css">
    <link rel="stylesheet" href="~/base/lightbox.min.css">
    <link rel="stylesheet" href="~/base/group.css">
    <link rel="stylesheet" href="~/base/MembersDetail.css">
    <link rel="stylesheet" href="~/base/blog-detail.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" integrity="sha512-tS3S5qG0BlhnQROyJXvNjeEM4UpMXHrQfTGmbQ1gKmelCxlSEBUaxhRBj/EFTzpbP4RVSrpEikbmdJobCvhE3g==" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.css" integrity="sha512-OTcub78R3msOCtY3Tc6FzeDJ8N9qvQn1Ph49ou13xgA9VsH9+LRxoFU6EqLhW4+PKRfU+/HReXmSZXHEkpYoOA==" crossorigin="anonymous" />

</head>
<body>
    <header class="header">
        <div class="header-actions header-logo">
            <a href="#" class="header-logo-link">
                <img src="https://odindesignthemes.com/vikinger-theme/wp-content/uploads/2020/09/cropped-logovikinger.png" alt="" class="header-logo-img">
                <div class="header-logo-text">BKCH</div>
            </a>
        </div>
        <div class="header-actions">
            <i class="fas fa-bars header-icon-slide-menu"></i>
        </div>
        <div class="header-actions">Home</div>
        <div class="header-actions menu-main">
            Features
            <i class="fas fa-caret-down header-action-icon-down"></i>
            <!-- menu features -->
            <div class="menu-features">
                <div class="menu-feature__body">
                    <h1 class="menu-feature__body-heading">BuddyPress</h1>
                    <ul class="menu-feature__body-list">
                        <li class="menu-feature__body-item">Profile Timeline</li>
                        <li class="menu-feature__body-item">Profile About</li>
                        <li class="menu-feature__body-item">Profile Friends</li>
                        <li class="menu-feature__body-item">Profile Groups</li>
                        <li class="menu-feature__body-item">Profile Blog Posts</li>
                        <li class="menu-feature__body-item">Profile Photos</li>
                        <li class="menu-feature__body-item">Activity</li>
                    </ul>
                </div>
                <div class="menu-feature__body">
                    <h1 class="menu-feature__body-heading">GamiPress</h1>
                    <ul class="menu-feature__body-list">
                        <li class="menu-feature__body-item">Badges</li>
                        <li class="menu-feature__body-item">Profile Badges</li>
                        <li class="menu-feature__body-item">Quests</li>
                        <li class="menu-feature__body-item">Profile Quests</li>
                        <li class="menu-feature__body-item">Ranks</li>
                        <li class="menu-feature__body-item">Profile Rank</li>


                    </ul>
                </div>
                <div class="menu-feature__body">
                    <h1 class="menu-feature__body-heading">More Links</h1>
                    <ul class="menu-feature__body-list">
                        <li class="menu-feature__body-item">Group Timeline</li>
                        <li class="menu-feature__body-item">Group Members</li>
                        <li class="menu-feature__body-item">Group Photos</li>
                        <li class="menu-feature__body-item">Landing</li>
                        <li class="menu-feature__body-item">Blog</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- <div class="header-actions menu-more">More
            <i class="fas fa-caret-down header-action-icon-down"></i>

            <div class="menu-more-container">
                <div class="menu-more-item">Other Items</div>
                <div class="menu-more-item">Our Website</div>
            </div>
        </div> -->
        <div class="header-actions header-seacher">
            <div class="header-seach">
                <input type="text" placeholder="Search here for people, groups and posts" class="header-seach-input">
                <i class="fas fa-search header-seach-icon"></i>
            </div>
        </div>
        <div class="header-actions">
            <a href="/Home/Profile" class="header-profile-link" style="display: flex; align-items: center; text-decoration: none; color: inherit;">
                <i class="fas fa-user" style="margin-right: 5px;"></i>
                <span>Profile</span>
            </a>
        </div>

        
        <partial name="_LoginPartial"/>
        

        

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-top">
                <div class="footer-info">
                    <div class="footer-info-brand">
                        <img src="./images/cropped-logovikinger (1).png" alt="Logo" class="footer-info-brand-image">
                        <div class="footer-info-brand-info">
                            <p class="footer-info-brand-title">BKCH</p>
                            <p class="footer-info-brand-subtitle">BuddyPress Social Community</p>
                        </div>
                    </div>
                    <p class="footer-info-text">
                        BKCH Social Community was created in 2020, designed to be a new and exciting way to bring
                        people together!
                    </p>
                    <div class="social-items">
                        <a href="#" class="social-item facebook">
                            <i class="fab fa-facebook-square"></i>
                        </a>
                        <a href="#" class="social-item twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="social-item instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="social-item youtube">
                            <i class="fab fa-youtube"></i>
                        </a>
                    </div>
                </div>

                <div class="footer-navigation">
                    <div class="navigation-section">
                        <p class="navigation-section-title">
                            BuddyPress
                        </p>
                        <div class="navigation-section-links">
                            <a href="#" class="navigation-section-link">Profile Timeline</a>
                            <a href="#" class="navigation-section-link">Profile About</a>
                            <a href="#" class="navigation-section-link">Profile Friends</a>
                            <a href="#" class="navigation-section-link">Profile Groups</a>
                            <a href="#" class="navigation-section-link">Profile Blog Posts</a>
                            <a href="#" class="navigation-section-link">Profile Photos</a>
                            <a href="#" class="navigation-section-link">Activity</a>
                            <a href="#" class="navigation-section-link">Members</a>
                            <a href="#" class="navigation-section-link">Groups</a>
                        </div>
                    </div>
                    <div class="navigation-section">
                        <p class="navigation-section-title">
                            GamiPress
                        </p>
                        <div class="navigation-section-links">
                            <a href="#" class="navigation-section-link">Badges</a>
                            <a href="#" class="navigation-section-link">Profile Badges</a>
                            <a href="#" class="navigation-section-link">Quests</a>
                            <a href="#" class="navigation-section-link">Profile Quests</a>
                            <a href="#" class="navigation-section-link">Ranks</a>
                            <a href="#" class="navigation-section-link">Profile Rank</a>
                            <a href="#" class="navigation-section-link">Credits</a>
                            <a href="#" class="navigation-section-link">Profile Credits</a>
                        </div>
                    </div>
                    <div class="navigation-section">
                        <p class="navigation-section-title">
                            More Links
                        </p>
                        <div class="navigation-section-links">
                            <a href="#" class="navigation-section-link">Group Timeline</a>
                            <a href="#" class="navigation-section-link">Group Members</a>
                            <a href="#" class="navigation-section-link">Group Photos</a>
                            <a href="#" class="navigation-section-link">Landing</a>
                            <a href="#" class="navigation-section-link">Blog</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js" integrity="sha512-bLT0Qm9VnAYZDflyKcBaQ2gg0hSYNQrJ8RilYldYQ1FxQYoCLtUjuuRuZo+fjqhx/qtq/1itJ0C2ejDxltZVFg==" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/is-in-viewport/3.0.4/isInViewport.min.js" integrity="sha512-eAT5Hvi9/Yx33YvSUPOpAYEA3HnUt5oKCSyPGRQwNgqD7K/90JRpFnkaL1M6ROZtLkckQKJ4WYh9cS7Urr4YjA==" crossorigin="anonymous"></script>
    <script src="./js/lightbox-plus-jquery.min.js"></script>
    <script src="./js/hightlight.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" integrity="sha512-bPs7Ae6pVvhOSiIcyUClR7/q2OAsRiovw4vAkX+zJbw3ShAeeqezq50RIIcIURq7Oa20rW2n2q+fyXBNcU9lrw==" crossorigin="anonymous"></script>
    <script src="./js/main.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
